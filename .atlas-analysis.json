{
  "projectType": "sdk-library",
  "projectName": "Standard Webhooks",
  "projectDescription": "Two TypeScript packages for producing and consuming type-safe, Standard Webhooks-compliant webhooks: @webhooks/sdk for senders (direct or transactional-outbox delivery) and @webhooks/verify for receivers (zero-dependency HMAC-SHA256 verification).",
  "theme": "luma",
  "primaryColor": "#242424",
  "lightColor": "#a3a3a3",
  "darkColor": "#d6d6d6",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
