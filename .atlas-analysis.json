  },
  "keyFeatures": [
    "Type-safe event definitions using any Standard Schema library (Zod, Valibot, ArkType)",
    "Direct in-process delivery with automatic retries and exponential backoff",
    "Transactional outbox delivery — rows commit atomically with your database transaction",
    "Background worker for polling and delivering outbox rows",
    "Zero-dependency signature verification using WebCrypto",
    "Standard Webhooks wire format (HMAC-SHA256) — compatible with Svix senders",
    "Subject scoping for multi-tenant event routing",
    "Typed event unions for consumers with no runtime dependency on the sender",
    "Failure reason codes (never thrown exceptions) for predictable error handling",
    "Runs on Node 20+, Bun, Deno, Cloudflare Workers, and edge runtimes"
  ],
  "publicApiSurface": [
    "webhooks(config): DirectWebhooks | OutboxWebhooks",
    "direct(opts?): DirectDelivery",
    "outbox(adapter, opts?): OutboxDelivery",
    "wh.send(input): Promise<Result<DirectSendReport | EnqueueReport>>",
    "wh.with(tx).send(input): Promise<Result<EnqueueReport>>",
    "wh.worker(opts?): OutboxWorker",
    "worker.start(): void",
    "worker.stop(): Promise<void>",
    "worker.tick(): Promise<TickReport>",
    "createVerifier(secret, opts?): Verifier",
    "verifier.verify(request): Promise<VerifyResult>",
    "verifier.verifyPayload(payload, headers): Promise<VerifyResult>",
    "memoryAdapter(): MemoryAdapter",
    "isValidSecret(secret): boolean",
    "signPayload(secret, eventId, timestampSec, payload): Promise<string>",
    "EventUnion<E>",
    "OutboxAdapter<Tx>",
    "OutboxRow",
    "VerifyFailure",
    "VerifyResult<T>",
    "Subscriber",
    "SubscriberResolver"
  ]
}
